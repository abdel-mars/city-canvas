# Supabase Edge Function secrets. Set with:
#   supabase secrets set APP_ORIGIN=https://your-domain
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase runtime and must not be set by hand.

# Absolute origin of the deployed site. CORS is refused for any other origin —
# there is no wildcard.
APP_ORIGIN=http://localhost:8080

# Optional: rate limit share creation per IP. Without it, authenticated users can
# still upload without a per-IP cap (JWT verification still applies).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
