# Copy to .env.local and fill in real values. Never commit the filled-in file.

# ── Supabase (auth, galleries, shares) ───────────────────────────────
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# ── Fourthwall (server-side only, /api/create-fourthwall, ─────────
#         /api/fourthwall-pricing) ────────────────────────────────────────
# Open API user from Fourthwall → Settings → For Developers → Open API user.
# NEVER prefix these with VITE_ — that would expose them to the browser.
FOURTHWALL_API_USERNAME=
FOURTHWALL_API_PASSWORD=
# Storefront domain (no scheme), e.g. citylines.fourthwall.com
FOURTHWALL_SHOP_DOMAIN=
# Optional: override the template ids. Defaults are the framed matte poster + kiss-cut stickers.
FOURTHWALL_TEMPLATE_ID=pro_kRSsoYjwSoyyTEmWko5o0A
FOURTHWALL_STICKER_TEMPLATE_ID=pro_358
FOURTHWALL_STICKER_SHEET_TEMPLATE_ID=pro_6a8bdd4fd14d4cf687
FOURTHWALL_MUG_TEMPLATE_ID=pro_4v5OfYhyRx62KW5b7Oj6Uw
# Optional: secret for the internal background trigger. Defaults to FOURTHWALL_API_PASSWORD.
FOURTHWALL_BG_SECRET=
# Absolute origin of the deployed site. Used to lock down CORS.
APP_ORIGIN=http://localhost:8080

# ── Social automation (server-side only) ──────────────────────────────
# Supabase service role is used by the worker and queue APIs, never the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Instagram Login API credentials (professional account + Meta app).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Pinterest API v5 credentials and destination board.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# Optional Pinterest section inside the board.
PINTEREST_BOARD_SECTION_ID=
# Shared secret checked by /api/social-tick and /api/social-cleanup.
SOCIAL_CRON_SECRET=
# Set to false to publish direct shop links and skip click logging.
SOCIAL_TRACKING_ENABLED=true
# Optional overrides. Defaults: shop URL and the Africa/Casablanca timezone.
SOCIAL_SHOP_URL=https://citylinesart-shop.fourthwall.com/

# ── Geo proxy (Overpass + Nominatim) ──────────────────────────────────
# REQUIRED. Overpass's operators permanently ban clients that do not identify
# themselves, and there is no safe default. Format: an email or a URL.
# Sent as: CityLines/1.0 (<this value>)
#
# Left empty, the proxy returns 503 "unconfigured" for both search and road
# loading, and the UI reports it as "City search is not configured. Set
# GEOCONTACT in .env and restart." `npm run dev` refuses to start without it.
# Use your own address — never a third party's.
GEOCONTACT=mailto:you@example.com

# ── Rate limiting (required) ─────────────────────────────────────────
# Anonymous prints are allowed but capped. The endpoint fails closed (503) if
# these are missing, so the paid Printify account is never left unprotected.
#
#   requests  30/hour/IP  +  300/hour global   <- checked before any Printify call
#   creations  5/hour/IP  +  30/day/IP  +  200/day global
#
# Re-printing the same design is served from the dedupe cache and is charged
# to neither tier.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
